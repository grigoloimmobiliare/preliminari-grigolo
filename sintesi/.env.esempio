# Copia questo file in "sintesi/.env" e adatta i valori (lo fa anche sintesi/installa.sh)

# Cartella condivisa del NAS in cui salvare documenti e PDF di sintesi
# Synology: /volume1/<cartella condivisa>   QNAP: /share/<cartella condivisa>
CARTELLA_DATI=/volume1/Sintesi

# Porta della pagina web: http://<indirizzo-del-NAS>:8081 (i preliminari usano la 8080)
PORTA=8081

# Utente e gruppo del NAS (comando "id" in SSH). Synology: primo utente 1026, gruppo users 100
PUID=1026
PGID=100

# Nome riportato nell'intestazione del PDF
AGENZIA=Grigolo Immobiliare
