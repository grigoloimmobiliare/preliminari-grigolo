# Copia questo file in ".env" e adatta i valori (lo fa anche ./installa.sh)

# Cartella condivisa del NAS in cui salvare pratiche e modello
# Synology: /volume1/<cartella condivisa>   QNAP: /share/<cartella condivisa>
CARTELLA_DATI=/volume1/Preliminari

# Porta della pagina web: http://<indirizzo-del-NAS>:8080
PORTA=8080

# Utente e gruppo del NAS (comando "id" in SSH). Synology: primo utente 1026, gruppo users 100
PUID=1026
PGID=100
